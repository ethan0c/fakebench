{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fakebench",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*",
			"/og/*",
			"/share/*"
		]
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "fakebench.com", "custom_domain": true },
		{ "pattern": "www.fakebench.com", "custom_domain": true }
	],
	"send_email": [
		{ "name": "MAILER", "destination_address": "hello@ocelabs.xyz" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fakebench",
			"database_id": "bf475fc3-211f-450b-b936-a53d5299c424"
		}
	],
	"unsafe": {
		"bindings": [
			{
				"name": "RL",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": {
					"limit": 12,
					"period": 60
				}
			}
		]
	},
	"vars": {
		"SITE_NAME": "FakeBench",
		"SITE_URL": "https://fakebench.com"
	},
	"triggers": {
		"crons": [
			"15 0 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}